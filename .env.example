# Puerto del servidor (por defecto 3000)
PORT=3000

# Base de datos LOCAL (PGlite, PostgreSQL embebido). Por defecto: ./.data/pglite
# Usa DB_DIR=memory para una base volátil que se borra al reiniciar.
# DB_DIR=./.data/pglite

# Cargar datos de demostración en una base vacía (true por defecto)
# DEMO_SEED=true

# Cuenta de administrador inicial (si no se indica: admin@clubsegorbe.demo / segorbe2026)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Secreto para firmar sesiones. Si se deja vacío se genera uno en .data/session-secret
# SESSION_SECRET=

# Proveedores de notificaciones (opcionales; sin ellos los avisos quedan como "pendiente de proveedor")
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
