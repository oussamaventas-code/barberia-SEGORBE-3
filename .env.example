# GEMINI_API_KEY: Required for optional AI features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of Google emails authorized as ADMIN on first login (optional).
# If left empty, the first authenticated user on a fresh database can claim owner setup.
ADMIN_EMAILS=""

# Optional Notification Providers (Leave empty until configured in production)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

SMS_PROVIDER_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
